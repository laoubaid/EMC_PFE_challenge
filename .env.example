# ==============================================================================
# EMC Carpooling Platform - Environment Variables Template
# Copy this file to .env or .env.local and adjust configuration values as needed.
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=_secret_
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Docker MySQL connection (matches compose.yaml database service):
DATABASE_URL="mysql://root:root@database:3306/emc_pfe?serverVersion=8.0.39&charset=utf8mb4"

# Local SQLite fallback (for development without Docker or MySQL):
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Local MySQL (if running MySQL natively on host):
# DATABASE_URL="mysql://root:root@127.0.0.1:3306/emc_pfe?serverVersion=8.0.39&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> docker / compose ###
MYSQL_ROOT_PASSWORD=root_password
###< docker / compose ###

###> symfony/messenger ###
# Synchronous routing is configured in messenger.yaml for route calculations.
# Doctrine transport used for any persistent background messages if needed.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> openrouteservice/api ###
# OpenRouteService Directions API configuration
# Obtain a free API key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_BASE_URL=https://api.openrouteservice.org
###< openrouteservice/api ###
