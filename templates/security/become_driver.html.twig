{% extends 'base.html.twig' %}

{% block title %}Become a Driver{% endblock %}

{% block body %}
<div style="max-width: 500px; margin: 30px auto;">
    <div class="card" style="box-shadow: var(--shadow-md);">
        <div style="text-align: center; margin-bottom: 24px;">
            <div style="font-size: 2.2rem; margin-bottom: 8px;">🚗</div>
            <h1 class="card-title" style="font-size: 1.4rem;">Register Your Vehicle</h1>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 4px;">
                Add your vehicle details to start publishing rides and taking passengers
            </p>
        </div>

        <form method="post" action="{{ path('app_become_driver') }}">
            <div class="form-group">
                <label for="brand" class="form-label">Car Brand</label>
                <input type="text" name="brand" id="brand" class="form-control" required placeholder="e.g. Dacia, Renault, Peugeot">
            </div>

            <div class="form-group">
                <label for="model" class="form-label">Car Model</label>
                <input type="text" name="model" id="model" class="form-control" required placeholder="e.g. Logan, Clio 5, 208">
            </div>

            <div class="form-group">
                <label for="plate" class="form-label">Moroccan License Plate</label>
                <input type="text" name="plate" id="plate" class="form-control" required placeholder="e.g. 12345-A-1">
                <div class="form-hint">Format: Number - Arabic letter code - Region number</div>
            </div>

            <div class="form-group">
                <label for="seats" class="form-label">Total Passenger Seats (excluding driver)</label>
                <input type="number" name="seats" id="seats" class="form-control" min="1" max="8" value="4" required>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">
                Activate Driver Account
            </button>
        </form>
    </div>
</div>
{% endblock %}
