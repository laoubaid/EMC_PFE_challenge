{% extends 'base.html.twig' %}

{% block title %}Publish a Ride — CarpoolMorocco{% endblock %}

{% block body %}
<div class="page-header" style="margin-bottom: 24px;">
    <div>
        <a href="{{ path('driver_dashboard') }}" style="color: var(--primary); text-decoration: none; font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px;">
            ← Back to Driver Space
        </a>
        <h1 style="font-size: 1.6rem; font-weight: 800;">Publish an Inter-City Ride</h1>
        <p style="font-size: 0.9rem; color: var(--text-muted);">Configure your route, intermediate stops, schedules, and available seats</p>
    </div>
</div>

<div style="max-width: 760px; margin: 0 auto;">
    <div class="card">
        <form method="post" action="{{ path('driver_trip_new') }}" id="new-trip-form">
            <!-- Step 1: Vehicle -->
            <div class="form-group">
                <label for="vehicle_id" class="form-label">Vehicle to Use</label>
                <select name="vehicle_id" id="vehicle_id" class="form-control" required>
                    {% for vehicle in vehicles %}
                        <option value="{{ vehicle.id }}">
                            {{ vehicle.brand }} {{ vehicle.model }} (Plate: {{ vehicle.plate }}, {{ vehicle.seats }} total seats)
                        </option>
                    {% endfor %}
                </select>
                <div class="form-hint">
                    Need to add another car? <a href="{{ path('driver_vehicles') }}" style="color: var(--primary);">Manage vehicles here</a>.
                </div>
            </div>

            <!-- Step 2: Route Origin & Destination -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label for="origin_city_id" class="form-label">Departure City (Origin)</label>
                    <select name="origin_city_id" id="origin_city_id" class="form-control" onchange="fetchRoutePreview()" required>
                        <option value="">Select city...</option>
                        {% for city in cities %}
                            <option value="{{ city.id }}">{{ city.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label for="dest_city_id" class="form-label">Destination City</label>
                    <select name="dest_city_id" id="dest_city_id" class="form-control" onchange="fetchRoutePreview()" required>
                        <option value="">Select destination...</option>
                        {% for city in cities %}
                            <option value="{{ city.id }}">{{ city.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <!-- Step 3: Date & Departure Time -->
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label for="departure_date" class="form-label">Departure Date</label>
                    <input type="date" name="departure_date" id="departure_date" class="form-control" min="{{ 'now'|date('Y-m-d') }}" required>
                </div>

                <div class="form-group">
                    <label for="departure_time" class="form-label">Departure Time</label>
                    <input type="time" name="departure_time" id="departure_time" class="form-control" required>
                </div>

                <div class="form-group">
                    <label for="total_seats" class="form-label">Seats Offered</label>
                    <input type="number" name="total_seats" id="total_seats" class="form-control" min="1" max="8" value="3" required>
                </div>
            </div>

            <!-- Step 4: Intermediate Stops (Dynamic) -->
            <div style="margin: 24px 0; border-top: 1px solid var(--border); padding-top: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <div>
                        <h3 style="font-size: 1rem; font-weight: 700;">Intermediate Stops (Optional)</h3>
                        <p style="font-size: 0.82rem; color: var(--text-muted);">
                            Add cities where you can drop off or pick up passengers along your way.
                        </p>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline" onclick="addIntermediateStop()">
                        + Add Stop
                    </button>
                </div>

                <div id="intermediate-stops-container"></div>
            </div>

            <!-- Step 5: Final Destination Road Details (Computed by ORS Routing) -->
            <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 18px; margin-bottom: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0;">Road Route & Travel Details (Computed by OpenRouteService)</h4>
                    <span id="route-badge" class="badge" style="display: none; background: #e0f2fe; color: #0369a1;">Route Ready</span>
                </div>

                <!-- Loading State -->
                <div id="route-loading" style="display: none; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--primary); font-weight: 600; padding: 8px 0;">
                    <span>⏳ Calculating driving distance & ETAs via OpenRouteService...</span>
                </div>

                <!-- Error Message -->
                <div id="route-error" style="display: none; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 10px 14px; border-radius: 6px; font-size: 0.85rem; margin-bottom: 14px;">
                </div>

                <!-- Readonly Computed Fields -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label for="dest_distance_km" class="form-label">Total Distance to Destination (km)</label>
                        <input type="number" step="0.1" name="dest_distance_km" id="dest_distance_km" class="form-control" placeholder="Auto-calculated from route" readonly required style="background: #f1f5f9; cursor: not-allowed;">
                        <div class="form-hint">Road distance computed automatically by OpenRouteService.</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label for="dest_arrival_time" class="form-label">Estimated Travel Time (Minutes)</label>
                        <input type="number" name="dest_arrival_time" id="dest_arrival_time" class="form-control" placeholder="Auto-calculated from route" readonly required style="background: #f1f5f9; cursor: not-allowed;">
                        <div class="form-hint" id="dest-eta-hint">Raw driving duration without stop buffers.</div>
                    </div>
                </div>

                <!-- Live ETA Preview Banner -->
                <div id="route-summary-banner" style="display: none; margin-top: 14px; background: white; border: 1px solid #bfdbfe; border-radius: 6px; padding: 10px 14px; font-size: 0.88rem;">
                    <strong>Live Itinerary Preview:</strong> <span id="route-summary-text" style="color: var(--primary); font-weight: 700;"></span>
                </div>
            </div>

            <button type="submit" id="submit-btn" class="btn btn-primary btn-lg" style="width: 100%;">
                Publish This Ride
            </button>
        </form>
    </div>
</div>

<script>
let stopCount = 0;
const citiesData = [
    {% for city in cities %}
        { id: {{ city.id }}, name: "{{ city.name }}" },
    {% endfor %}
];

function addIntermediateStop() {
    stopCount++;
    const container = document.getElementById('intermediate-stops-container');
    const div = document.createElement('div');
    const rowId = 'stop-row-' + stopCount;
    div.id = rowId;
    div.className = 'intermediate-stop-row';
    div.style = "display: flex; flex-direction: column; gap: 8px; background: #fafafa; border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin-bottom: 12px;";

    let cityOptions = '<option value="">Select intermediate city...</option>';
    citiesData.forEach(c => {
        cityOptions += `<option value="${c.id}">${c.name}</option>`;
    });

    div.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
            <div style="flex: 1;">
                <label class="form-label" style="font-size: 0.78rem; font-weight: 700; margin-bottom: 4px;">Intermediate Stop</label>
                <select name="intermediate_cities[]" class="form-control stop-city-select" onchange="fetchRoutePreview()" required>
                    ${cityOptions}
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-outline" style="color: var(--danger); height: 38px; margin-top: 20px;" onclick="removeIntermediateStop('${rowId}')" title="Remove Stop">
                ✕
            </button>
        </div>
        <div class="stop-eta-display" style="font-size: 0.82rem; color: var(--text-muted); font-weight: 600; padding: 2px 4px;">
            Select a city to calculate stop ETA...
        </div>
    `;
    container.appendChild(div);
    fetchRoutePreview();
}

function removeIntermediateStop(rowId) {
    const el = document.getElementById(rowId);
    if (el) {
        el.remove();
        fetchRoutePreview();
    }
}

let fetchTimeout = null;

function fetchRoutePreview() {
    if (fetchTimeout) {
        clearTimeout(fetchTimeout);
    }
    fetchTimeout = setTimeout(doFetchRoutePreview, 250);
}

function doFetchRoutePreview() {
    const originSelect = document.getElementById('origin_city_id');
    const destSelect = document.getElementById('dest_city_id');
    const originId = parseInt(originSelect.value, 10);
    const destId = parseInt(destSelect.value, 10);

    const errorDiv = document.getElementById('route-error');
    const loadingDiv = document.getElementById('route-loading');
    const badge = document.getElementById('route-badge');
    const distInput = document.getElementById('dest_distance_km');
    const timeInput = document.getElementById('dest_arrival_time');
    const etaHint = document.getElementById('dest-eta-hint');
    const banner = document.getElementById('route-summary-banner');
    const bannerText = document.getElementById('route-summary-text');
    const submitBtn = document.getElementById('submit-btn');

    // Collect intermediate city IDs in order
    const stopSelects = document.querySelectorAll('.stop-city-select');
    const intermediateIds = [];
    stopSelects.forEach(sel => {
        const val = parseInt(sel.value, 10);
        if (val > 0) {
            intermediateIds.push(val);
        }
    });

    if (!originId || !destId) {
        distInput.value = '';
        timeInput.value = '';
        errorDiv.style.display = 'none';
        loadingDiv.style.display = 'none';
        badge.style.display = 'none';
        banner.style.display = 'none';
        return;
    }

    if (originId === destId) {
        errorDiv.textContent = 'Departure and destination cannot be the same city.';
        errorDiv.style.display = 'block';
        badge.style.display = 'none';
        banner.style.display = 'none';
        distInput.value = '';
        timeInput.value = '';
        return;
    }

    errorDiv.style.display = 'none';
    loadingDiv.style.display = 'flex';
    badge.style.display = 'none';

    fetch('{{ path('driver_route_preview') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        },
        body: JSON.stringify({
            origin_city_id: originId,
            dest_city_id: destId,
            intermediate_city_ids: intermediateIds
        })
    })
    .then(res => res.json())
    .then(data => {
        loadingDiv.style.display = 'none';
        if (data.success) {
            distInput.value = data.totalDistanceKm;
            timeInput.value = data.totalDurationMin;
            etaHint.textContent = `Raw: ${data.totalDurationMin} min | Buffered: ${data.totalBufferedDurationMin} min (${data.totalFormattedEta})`;

            badge.style.display = 'inline-block';
            banner.style.display = 'block';
            bannerText.textContent = `${data.totalFormattedEta}`;

            // Update intermediate stop ETA labels
            const stopRows = document.querySelectorAll('.intermediate-stop-row');
            stopRows.forEach((row, i) => {
                const etaDisplay = row.querySelector('.stop-eta-display');
                // stop 0 is origin, stops 1..n are intermediate
                const stopData = data.stops ? data.stops[i + 1] : null;
                if (etaDisplay && stopData) {
                    etaDisplay.textContent = `📍 Stop #${i + 1} (${stopData.cityName}): ${stopData.formattedEta} from departure`;
                    etaDisplay.style.color = 'var(--text-main)';
                }
            });
        } else {
            errorDiv.textContent = data.error || 'Failed to compute road route.';
            errorDiv.style.display = 'block';
            distInput.value = '';
            timeInput.value = '';
            banner.style.display = 'none';
        }
    })
    .catch(err => {
        loadingDiv.style.display = 'none';
        errorDiv.textContent = 'Network or server error while computing route: ' + err.message;
        errorDiv.style.display = 'block';
        distInput.value = '';
        timeInput.value = '';
        banner.style.display = 'none';
    });
}
</script>
{% endblock %}
